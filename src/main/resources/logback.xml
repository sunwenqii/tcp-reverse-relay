<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <contextName>TCP Reverse Relay</contextName>

    <appender name="consoleLog" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%-10thread] [%-45logger{36}] [%-5level] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="journalLog" class="dev.sunwenqi.tcpreverserelay.observability.JournalLogAppender"/>

    <root level="INFO">
        <appender-ref ref="consoleLog"/>
        <appender-ref ref="journalLog"/>
    </root>

    <logger level="INFO" name="dev.sunwenqi.tcpreverserelay"/>
</configuration>
